include README.md
include LICENSE
include CONTRIBUTING.md
include SECURITY.md
include pyproject.toml
recursive-include .github *.yml
recursive-include circhecker/schemas *.json
recursive-include docs *.md
recursive-include examples *.py *.cir *.png *.svg *.md
