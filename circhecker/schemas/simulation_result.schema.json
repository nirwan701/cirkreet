{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nirwan701/cirkreet/schemas/simulation_result.schema.json",
  "title": "SimulationResult",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "circuit_id",
    "analysis_id",
    "status",
    "backend",
    "requested_analyses",
    "analyses",
    "metrics",
    "checks",
    "warnings",
    "errors"
  ],
  "properties": {
    "schema": {"const": "SimulationResult"},
    "schema_version": {"const": "1.0.0"},
    "circuit_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "analysis_id": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["success", "partial", "failed", "unsupported"]},
    "backend": {"type": ["string", "null"]},
    "requested_analyses": {"type": "array", "items": {"type": "string"}},
    "analyses": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "message", "data", "units", "diagnostics"],
        "properties": {
          "status": {"enum": ["success", "failed", "unsupported", "not_applicable", "skipped", "unknown"]},
          "message": {"type": "string"},
          "data": {},
          "units": {"type": "object", "additionalProperties": {"type": "string"}},
          "diagnostics": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "metrics": {"type": "object"},
    "checks": {"type": "object"},
    "warnings": {"type": "array"},
    "errors": {"type": "array"}
  },
  "additionalProperties": false
}
